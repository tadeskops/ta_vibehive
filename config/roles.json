{
  "hierarchy": [
    { "id": "admin",       "label": "Admin",                "rank": 100, "badge": "role-badge",     "description": "System owner. Configures features, roles, receipt archive, branding. Never touches day-to-day event ops." },
    { "id": "secretary",   "label": "Society Secretary",    "rank": 90,  "badge": "role-badge sec", "description": "Executive oversight role. Can review moderator actions, approve event workflows, and manage settings without full system-owner privileges." },
    { "id": "mgmt",        "label": "Management Committee", "rank": 80,  "badge": "role-badge mc",   "description": "Elected committee. Approves budgets, verifies payments, publishes receipts." },
    { "id": "committee",   "label": "Sub-Committee",        "rank": 60,  "badge": "role-badge cmt",  "description": "Cultural / Sports / Volunteer sub-committees. Creates events under their cluster, tracks contributions." },
    { "id": "manager",     "label": "Society Manager",      "rank": 40,  "badge": "role-badge mgr",  "description": "On-site manager. Records offline (cash / cheque) payments, generates duplicate receipts, prints reports." },
    { "id": "resident",    "label": "Resident",             "rank": 20,  "badge": "role-badge res",  "description": "Contributes, registers for events, downloads own receipts, sees permitted public boards." }
  ],
  "permissions": {
    "society.brand.edit":        ["admin"],
